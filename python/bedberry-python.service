[Unit]
Description=Bedberry Python Core
Documentation=https://github.com/DarwinInnovation/bedberry
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/bedberry/python
Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=info
ExecStart=/home/pi/bedberry/python/.venv/bin/python -m bedberry.main --config-dir /home/pi/bedberry/python/cfg --i2c-bus 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
